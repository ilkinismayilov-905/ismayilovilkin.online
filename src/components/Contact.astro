---
import { getSingle, useT, type Locale } from '../i18n/utils';
import ExternalLink from './ExternalLink.astro';
import BgCaption from './BgCaption.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const { sectionBackgrounds } = (await getSingle('site', locale)).data;
const bgName = sectionBackgrounds.contact;
// a caption only where the photo changes
const showCaption = bgName !== sectionBackgrounds.awards;
const t = useT(locale);
const { contact } = (await getSingle('site', locale)).data;
const [pre, mid, post] = t('colophon.search').split(/\{k\d\}/);
---
<footer class="contact wrap" id="contact" aria-labelledby="ct-h" data-bg={bgName}>
  <div class="contact-card glass">
    <h2 id="ct-h" tabindex="-1">{t('contact.title')}</h2>
    <p class="s-note">{contact.note}</p>
    <a class="email" href={`mailto:${contact.email}`}>{contact.email.split('@')[0]}<wbr />@{contact.email.split('@')[1]}</a>
    <div class="contact-actions">
      <button class="btn-accent" id="copyBtn" type="button">{t('contact.copy')}</button>
      <ul class="contact-links" aria-label={t('contact.linksLabel')}>
        <li><ExternalLink href={contact.github} locale={locale}>GitHub</ExternalLink></li>
        <li><ExternalLink href={contact.linkedin} locale={locale}>LinkedIn</ExternalLink></li>
      </ul>
    </div>
  </div>
  {showCaption && <BgCaption locale={locale} name={bgName} />}
  <div class="colophon">
    <span>{t('colophon.font')}</span>
    <span class="js-only">{pre}<kbd class="kbd-hint">⌘K</kbd>{mid}<kbd>/</kbd>{post}</span>
  </div>
</footer>
