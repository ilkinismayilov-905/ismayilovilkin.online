---
// Context for the background photo of this part. In the page flow, so it never covers text or the face.
// Hidden from assistive tech: the background itself is decorative.
import { getSingle, type Locale } from '../i18n/utils';

interface Props { locale: Locale; name: string }
const { locale, name } = Astro.props;
const caption = (await getSingle('site', locale)).data.backgrounds[name]?.caption;
---
{caption && <p class="bg-caption glass js-only" aria-hidden="true">{caption}</p>}
