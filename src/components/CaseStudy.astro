---
import type { CollectionEntry } from 'astro:content';
import { projectSlug, useT, type Locale } from '../i18n/utils';
import { motifSvg } from '../lib/motif';
import ExternalLink from './ExternalLink.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
  /** 'h3' inside the home page and dialog (baseline layout); 'h1' on the standalone page (rich layout) */
  heading: 'h1' | 'h3';
  id?: string;
}
const { project, locale, heading: Title, id } = Astro.props;
const t = useT(locale);
const d = project.data;
const rich = Title === 'h1';
const Sub = rich ? 'h2' : 'h4';
const facts = [
  ...(d.year ? [{ label: t('facts.year'), value: String(d.year) }] : []),
  ...(d.stack ? [{ label: t('facts.stack'), value: d.stack.join(', ') }] : []),
  ...d.facts,
];
const sections = d.sections
  ? ([
      [t('case.problem'), d.sections.problem],
      [t('case.did'), d.sections.did],
      [t('case.decision'), d.sections.decision],
      [t('case.result'), d.sections.result],
    ] as const)
  : [];
---
{rich ? (
  <article class="case case-rich">
    <header class="case-head">
      <div>
        <Title data-vt={projectSlug(project)}>{d.title}</Title>
        {d.lede && <p class="lede">{d.lede}</p>}
      </div>
      <div class="case-motif" set:html={motifSvg(d.motif)} />
    </header>
    <div class="case-grid">
      <div class="case-main">
        {d.live && (
          <p class="live-link">
            <ExternalLink href={d.live.url} locale={locale}>{t('live.open', { title: d.title })}</ExternalLink>
            {d.live.coldStart && <span class="live-note">{t('live.cold')}</span>}
          </p>
        )}
        {sections.map(([label, text]) => <Fragment><Sub>{label}</Sub><p>{text}</p></Fragment>)}
      </div>
      <aside class="case-facts glass" aria-label={t('case.facts')}>
        <dl>{facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}</dl>
      </aside>
    </div>
  </article>
) : (
  <article class="case" id={id}>
    <Title>{d.title}</Title>
    {d.lede && <p class="lede">{d.lede}</p>}
    <dl class="facts">
      {facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
    </dl>
    {d.live && (
      <p class="live-link">
        <ExternalLink href={d.live.url} locale={locale}>{t('live.open', { title: d.title })}</ExternalLink>
        {d.live.coldStart && <span class="live-note">{t('live.cold')}</span>}
      </p>
    )}
    {sections.map(([label, text]) => <Fragment><Sub>{label}</Sub><p>{text}</p></Fragment>)}
  </article>
)}
