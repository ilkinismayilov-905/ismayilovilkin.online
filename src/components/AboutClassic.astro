---
// About in the prototype's layout (text + "How I work" glass card); each chapter switches the page background.
import { getSingle, useT, type Locale } from '../i18n/utils';
import BgCaption from './BgCaption.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);
const { chapters, principles, skills } = (await getSingle('about', locale)).data;
---
<section id="about" aria-labelledby="about-h">
  <div class="wrap">
    <div class="s-head"><h2 id="about-h" tabindex="-1">{t('about.title')}</h2></div>
    <div class="about-grid">
      <div class="about-text">
        {chapters.map((c) => (
          <div class="chapter" data-bg={c.background} data-scrim="soft">
            <h3>{c.title}</h3>
            {c.text.map((p) => <p>{p}</p>)}
            <BgCaption locale={locale} name={c.background} />
          </div>
        ))}
        <div class="skills">
          <h3>{t('skills.title')}</h3>
          <dl>{skills.map((s) => <div><dt>{s.group}</dt><dd>{s.items}</dd></div>)}</dl>
        </div>
      </div>
      <ul class="principles glass" aria-label={t('principles.label')}>
        {principles.map((p) => <li><strong>{p.title}</strong><span>{p.text}</span></li>)}
      </ul>
    </div>
  </div>
</section>
