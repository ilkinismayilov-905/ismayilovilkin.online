---
import { getProjects, getSingle, href, projectSlug, useT, type Locale } from '../i18n/utils';
import BgCaption from './BgCaption.astro';

interface Props { locale: Locale; photoBg?: boolean }
const { locale, photoBg = false } = Astro.props;
const bgName = (await getSingle('site', locale)).data.sectionBackgrounds.awards;
const t = useT(locale);
const { items } = (await getSingle('awards', locale)).data;
const titles = new Map((await getProjects(locale)).map((p) => [projectSlug(p), p.data.title]));
---
<section id="awards" aria-labelledby="aw-h" data-bg={bgName}>
  <div class="wrap">
    <div class="s-head"><h2 id="aw-h" tabindex="-1">{t('awards.title')}</h2></div>
    <ul class="list">
      {items.map((a) => (
        <li>
          <span class="l-date">{a.year ?? ''}</span>
          <span>
            <span class="l-title">{a.title}</span>
            <span class="l-text">
              {a.text}
              {a.project && <Fragment>{' '}<a href={href(locale, `work/${a.project}/`)}>{t('awards.project', { title: titles.get(a.project) ?? a.project })}</a></Fragment>}
            </span>
          </span>
          <!-- Rows linked to a case study are the two wins; they get the accent -->
          <span class:list={['l-result', { win: !!a.project }]}>{a.result}</span>
        </li>
      ))}
    </ul>
    {photoBg && <BgCaption locale={locale} name={bgName} />}
  </div>
</section>
