---
import { useT, type Locale } from '../i18n/utils';

interface Props { href: string; locale: Locale; class?: string }
const { href, locale, class: className } = Astro.props;
---
<a href={href} target="_blank" rel="noopener noreferrer" class={className}><slot /><span class="sr-only"> {useT(locale)('newTab')}</span></a>
