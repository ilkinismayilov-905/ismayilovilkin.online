# Originals: may contain GPS/EXIF and private data. Only sanitized copies are committed.
/photo/
/CV/
# Local proofs (contain photo copies) and tool caches
/.proof/
/graft/
.DS_Store

# Build and dependencies
node_modules/
dist/
.astro/

# Env
.env
.env.*
!.env.example
/.ignore

# Local privacy deny-list (contains the private values it guards against)
.privacy-denylist
# Test output
test-results/
playwright-report/
reports/

# Ruflo local secrets and runtime data
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/

# Local AI tooling (ruflo / claude-flow): runtime state and machine-specific config, never committed
.agents/
.claude-flow/
.swarm/
.mcp.json
ruvector.db
.claude/*
!.claude/launch.json
