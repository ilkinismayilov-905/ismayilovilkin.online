---
import { useT, type Locale } from '../i18n/utils';

interface Props { locale: Locale }
const t = useT(Astro.props.locale);
---
<div class="preview glass" id="preview" aria-hidden="true"></div>

<dialog class="case-dialog" id="caseDialog" aria-labelledby="caseLabel">
  <div class="case-top"><span id="caseLabel">{t('case.label')}</span><button class="close" id="caseClose" type="button">{t('case.close')}</button></div>
  <div class="case-body case" id="caseBody"></div>
</dialog>

<dialog class="palette" id="palette" aria-label={t('palette.label')}>
  <input id="palInput" type="text" role="combobox" aria-expanded="true" aria-controls="palList" aria-autocomplete="list"
         placeholder={t('palette.placeholder')} aria-label={t('palette.label')} autocomplete="off" spellcheck="false" />
  <ul id="palList" role="listbox" aria-label={t('palette.results')}></ul>
  <div class="pal-foot"><span><kbd>↑</kbd> <kbd>↓</kbd> {t('palette.move')}</span><span><kbd>Enter</kbd> {t('palette.open')}</span><span><kbd>Esc</kbd> {t('palette.close')}</span></div>
</dialog>

<div class="toast glass" id="toast" role="status" aria-live="polite"></div>
