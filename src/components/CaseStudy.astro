---
import type { CollectionEntry } from 'astro:content';
import { useT, type Locale } from '../i18n/utils';
import ExternalLink from './ExternalLink.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
  /** 'h3' inside the home page (under the Work h2); 'h1' on the standalone page */
  heading: 'h1' | 'h3';
  id?: string;
}
const { project, locale, heading: Title, id } = Astro.props;
const t = useT(locale);
const d = project.data;
const Sub = Title === 'h1' ? 'h2' : 'h4';
const facts = [
  ...(d.year ? [{ label: t('facts.year'), value: String(d.year) }] : []),
  ...(d.stack ? [{ label: t('facts.stack'), value: d.stack.join(', ') }] : []),
  ...d.facts,
];
const sections = d.sections
  ? ([
      [t('case.problem'), d.sections.problem],
      [t('case.did'), d.sections.did],
      [t('case.decision'), d.sections.decision],
      [t('case.result'), d.sections.result],
    ] as const)
  : [];
---
<article class="case" id={id}>
  <Title>{d.title}</Title>
  {d.lede && <p class="lede">{d.lede}</p>}
  <dl class="facts">
    {facts.map((f) => <div><dt>{f.label}</dt><dd>{f.value}</dd></div>)}
  </dl>
  {d.live && (
    <p class="live-link">
      <ExternalLink href={d.live.url} locale={locale}>{t('live.open', { title: d.title })}</ExternalLink>
      {d.live.coldStart && <span class="live-note">{t('live.cold')}</span>}
    </p>
  )}
  {sections.map(([label, text]) => <Fragment><Sub>{label}</Sub><p>{text}</p></Fragment>)}
</article>
