---
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseStudy from './CaseStudy.astro';
import BgCaption from './BgCaption.astro';
import { getProjects, getSingle, href, projectSlug, useT, type Locale } from '../i18n/utils';

interface Props { project: CollectionEntry<'projects'>; locale: Locale }
const { project, locale } = Astro.props;
const t = useT(locale);
const site = (await getSingle('site', locale)).data;
const bg = project.data.background ?? site.sectionBackgrounds.hero;
const slug = projectSlug(project);
const cases = (await getProjects(locale)).filter((p) => p.data.caseStudy);
const i = cases.findIndex((p) => projectSlug(p) === slug);
const prev = cases[i - 1];
const next = cases[i + 1];
---
<Base
  locale={locale}
  title={t('caseMeta.title', { title: project.data.title, name: site.person.name })}
  description={project.data.lede ?? project.data.summary}
  path={`work/${slug}/`}
  ogImage={`/og/${locale}-${slug}.jpg`}
  background={bg}
>
  <div class="wrap case-page" data-bg={bg}>
    <a class="back" href={`${href(locale, '')}#work`}>{t('case.back')}</a>
    <CaseStudy project={project} locale={locale} heading="h1" />
    <BgCaption locale={locale} name={bg} />
    {(prev || next) && (
      <nav class="case-nav" aria-label={t('case.more')}>
        {prev && <a class="prev" href={href(locale, `work/${projectSlug(prev)}/`)} rel="prev">{t('case.prev', { title: prev.data.title })}</a>}
        {next && <a class="next" href={href(locale, `work/${projectSlug(next)}/`)} rel="next">{t('case.next', { title: next.data.title })}</a>}
      </nav>
    )}
  </div>
</Base>
